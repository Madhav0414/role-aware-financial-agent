# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every variable here is OPTIONAL — the system answers every factual question
# with none of them set.

# --- Language model (optional) -------------------------------------------
# Supply at most one. The adapter auto-detects whichever is present and falls
# back to a deterministic, keyless path when neither is.
# Used only to interpret phrasing and word the final answer; never to decide
# access, and never to produce a figure.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Data refresh (optional) ---------------------------------------------
# SEC asks automated clients to identify themselves with a contact address.
# Only needed if you re-run scripts/fetch_data.py; the corpus is committed.
# Format: "Your Name your.email@example.com"
SEC_USER_AGENT=
